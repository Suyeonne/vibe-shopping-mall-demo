VITE_API_URL=/api

# Cloudinary Upload Widget
# Cloud name: 대시보드 상단의 Cloud name
VITE_CLOUDINARY_CLOUD_NAME=
# Upload preset: Settings > Upload > Upload presets (Unsigned)
VITE_CLOUDINARY_UPLOAD_PRESET=

# PortOne 고객사 식별코드
VITE_PORTONE_IMP_CODE=
# 필수: 포트원 콘솔 > 결제 연동 > 연동 정보 > 채널 관리의 채널키
VITE_PORTONE_CHANNEL_KEY=
